  <joint name="obsbot_mount_joint" type="fixed">
    <parent link="obsbot_mount_link" />
    <child link="obsbot_base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="obsbot_pan_joint" type="revolute">
    <parent link="obsbot_base_link" />
    <child link="obsbot_pan_link" />
    <origin xyz="0 0 0.0246" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-2.443460952792061" upper="2.443460952792061" effort="0.1" velocity="2.0943951023931953" />
  </joint>
  <joint name="obsbot_tilt_joint" type="revolute">
    <parent link="obsbot_pan_link" />
    <child link="obsbot_camera_link" />
    <origin xyz="0 -0.0044 0.02462" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-0.5235987755982988" upper="1.2217304763960306" effort="0.1" velocity="2.0943951023931953" />
  </joint>
  <link name="obsbot_camera_optical_frame" />
  <joint name="obsbot_optical_joint" type="fixed">
    <parent link="obsbot_camera_link" />
    <child link="obsbot_camera_optical_frame" />
    <origin xyz="0.0123 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966" />
